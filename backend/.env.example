# Local development only. Copy to backend/.env.
# MongoDB must be initialized as a replica set before using transactions.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=nosql_github_assistant
ELASTICSEARCH_URL=http://127.0.0.1:9200
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-before-running
NEO4J_DATABASE=neo4j
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CLIENT_ID=nosql-github-assistant-local
# Long random value, development routes only. Never put this in frontend code.
DEMO_WRITE_KEY=replace-with-a-new-long-random-key
# Optional: personal GitHub API token for higher rate limit (public importer only).
# GITHUB_TOKEN=
